# Configuração do Servidor Web e Aplicação
PORT=5000
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Opção 1: Conexão direta por parâmetros individuais (Render, VPS, etc.)
MYSQL_HOST=seu-mysql-remoto.exemplo.com
MYSQL_PORT=3306
MYSQL_USER=seu_usuario_mysql
MYSQL_PASSWORD=sua_senha_super_segura
MYSQL_DATABASE=megavarejo_erp

# Habilitar SSL (útil para bancos gerenciados como Aiven, PlanetScale, AWS RDS, etc.): true ou false
MYSQL_SSL=false
MYSQL_CONNECT_TIMEOUT=10

# Opção 2: Conexão por URL completa (Padrão no Railway, Render e Heroku)
# Se DATABASE_URL ou MYSQL_URL for informada, ela terá precedência sobre os parâmetros individuais.
# DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco
